## Main Production API Keys
# Get these from: https://www.binance.com/en/my/settings/api-management
# IMPORTANT: Enable ONLY "Enable Reading" permission for security
MAIN_API_KEY=your_binance_api_key_here
MAIN_API_SECRET=your_binance_api_secret_here

## == Testnet APIS (from testnet.binance.vision) == #
# Testnet API Keys  1
TESTNET_API_KEY=testnet_api_key_here
TESTNET_API_SECRET=testnet_api_secret_here

# Testnet Master Switch
# Set to "true" to force all operations to use the Testnet keys and endpoint.
BINANCE_TESTNET=true

# CoinGecko API (free tier, no key required)
# For pro features, get API key from: https://www.coingecko.com/en/api
COINGECKO_API_KEY=your_coingecko_api_key_here

